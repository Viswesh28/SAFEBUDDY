# Server
PORT=5000
JWT_SECRET=replace-with-a-long-random-value
CLIENT_ORIGIN=http://localhost:5173

# Storage: MONGO_URI > SUPABASE_DB_URL > local SQLite. Leave both unset for the demo.
# MONGO_URI=mongodb://127.0.0.1:27017/safebuddy
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Optional. SQLite file location (relative to server/). Default: data/safebuddy.sqlite
# SQLITE_PATH=data/safebuddy.sqlite
