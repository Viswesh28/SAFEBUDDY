PORT=5000
# Always use a unique long random secret outside local development.
JWT_SECRET=replace-with-a-long-random-value

# Optional. With no MONGO_URI, SafeBuddy runs on a local SQLite database.
MONGO_URI=mongodb://127.0.0.1:27017/safebuddy
CLIENT_ORIGIN=http://localhost:5173

# Optional. SQLite file location (relative to server/). Default: data/safebuddy.sqlite
# SQLITE_PATH=data/safebuddy.sqlite
