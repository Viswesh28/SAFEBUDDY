PORT=5000
# Always use a unique long random secret outside local development.
JWT_SECRET=replace-with-a-long-random-value

# Pick ONE hosted database, or leave both unset for the zero-setup SQLite demo.
# 1. MongoDB (highest priority when set)
# MONGO_URI=mongodb://127.0.0.1:27017/safebuddy
# 2. Supabase Postgres. Use the connection pooler string from Project Settings > Database.
#    Transaction mode (port 6543) is right for this API. Keep ?sslmode=require.
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Optional: connection pool size for Supabase (default 5).
# PG_POOL_MAX=5

CLIENT_ORIGIN=http://localhost:5173

# Optional. SQLite file location (relative to server/). Default: data/safebuddy.sqlite
# SQLITE_PATH=data/safebuddy.sqlite

# Production only. `npm run db:admin` uses these to create the first admin account,
# because demo accounts are never seeded when NODE_ENV=production.
# ADMIN_EMAIL=guide@example.org
# ADMIN_PASSWORD=use-at-least-12-characters
# ADMIN_NAME=School Guide
